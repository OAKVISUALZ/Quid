# ──────────────────────────────────────────────────────────────────────────────
# Quid Backend – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# Order of operations: build -> deploy -> init reputation -> fill these in.
# See ../README.md#deploy-checklist for the full walkthrough.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: postgresql://quid:quid@localhost:5432/quid_dev?schema=public
# Staging:   set to your hosted Postgres connection string
DATABASE_URL="postgresql://quid:quid@localhost:5432/quid_dev?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret for production/staging:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production/staging JWT_SECRET must be at least 32 characters.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Optional. How long SEP-10 JWTs stay valid (vercel-style duration string,
# e.g. "15m", "7d"). Defaults to "7d" when unset.
JWT_EXPIRES_IN="7d"

# ── CORS (Issue #348) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:  leave unset (falls back to http://localhost:3000)
# Staging:    CORS_ALLOWED_ORIGINS=https://staging.quid.app
# Production: CORS_ALLOWED_ORIGINS=https://quid.app
# NOTE: In production an unset CORS_ALLOWED_ORIGINS is treated as an error
# (the API fails to boot) rather than silently falling back to localhost.
CORS_ALLOWED_ORIGINS=

# ── Stellar / SEP-10 ──────────────────────────────────────────────────────────
# Server-side signing keypair secret (Stellar secret key starting with 'S').
# Generate a fresh keypair for each environment – NEVER share between envs.
STELLAR_SERVER_SECRET="S..."

# HOME_DOMAIN must match the domain that hosts your stellar.toml.
# Local dev:  HOME_DOMAIN=localhost
# Staging:    HOME_DOMAIN=staging.quid.app
# Production: HOME_DOMAIN=quid.app
HOME_DOMAIN="localhost"

# WEB_AUTH_DOMAIN is the domain of the SEP-10 auth server (usually same as API host).
# Local dev:  WEB_AUTH_DOMAIN=localhost
# Staging:    WEB_AUTH_DOMAIN=api.staging.quid.app
WEB_AUTH_DOMAIN="localhost"

# Stellar network passphrase.
# Testnet:    "Test SDF Network ; September 2015"
# Mainnet:    "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK="Test SDF Network ; September 2015"

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────
# Real pinning is used for mission-scoring model artifacts (Issue #307).
# Authentication: prefer a JWT for production/staging; legacy "key + secret"
# is accepted as a fallback and MUST NOT be used in production.
# When no Pinata credentials are configured the upload endpoints return 503
# instead of silently producing fake CIDs.
PINATA_JWT=""
PINATA_API_KEY=""
PINATA_API_SECRET=""

# Public gateway used to build download URLs for pinned artifacts.
# Local dev:  leave unset (falls back to https://gateway.pinata.cloud)
# Staging/Prod: your organization's Pinata gateway URL
IPFS_GATEWAY_URL=""

# Optional upload size cap in bytes (defaults to 5 MiB).
UPLOAD_MAX_BYTES=5242880

# Optional override of allowed MIME types (comma-separated). Defaults:
# images (png/jpeg/gif/webp), videos (mp4/webm/quicktime), pdf,
# application/json, text/plain
# UPLOAD_ALLOWED_MIME_TYPES="application/json,text/plain"

# ── Indexer (Issue #314) ──────────────────────────────────────────────────────
# Soroban RPC endpoint and the deployed quid-store contract id. When either is
# missing the indexer tick logs a debug line and returns instead of failing.
RPC_URL="https://soroban-testnet.stellar.org"
# Issue #321: live testnet quid-store deployment -- see
# quid-contract/README.md#deployed-on-testnet (throwaway deployer identity,
# not meant to hold real funds).
CONTRACT_ID="CAZL6GNSP42AOON45F6E55PUDNRS3RWOG6BCHKBTO4NWAWGOBIBPPYI7"

# ── Notifications (Issue #314) ────────────────────────────────────────────────
# Where outbound alerts are POSTed as JSON. Point it at Slack, Discord, or a
# transactional email provider. Leave empty to run with the in-app channel only,
# which always works and needs no configuration.
NOTIFICATION_WEBHOOK_URL=
