# Quid Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local -- NEXT_PUBLIC_* values are inlined into the client
# bundle at build time, so rebuild (or restart the dev server) after editing.
# Order of operations: build -> deploy -> init reputation -> fill these in.
# See ../README.md#deploy-checklist for the full walkthrough.

# Stellar / Soroban Contract IDs
# From `stellar contract deploy`. Live testnet deployments below, all with a
# throwaway Friendbot admin/deployer identity -- do not rely on them for
# anything that needs a trusted admin or real funds. See
# quid-contract/README.md#deployed-on-testnet before relying on any of these.
# Issue #321: quid-store, deployed fresh so `reject_submission` (and the rest
# of the entrypoint list) can be exercised end-to-end.
NEXT_PUBLIC_QUID_STORE_ID=CAZL6GNSP42AOON45F6E55PUDNRS3RWOG6BCHKBTO4NWAWGOBIBPPYI7
NEXT_PUBLIC_QUID_REPUTATION_ID=CDXKNUE2ZNZRZLJI5BK6M2KBMLXLAY4ITWTZG6G3BZP2O2AMQKHRCEWC
# Issue #284: deployed and initialized; `get_admin` / `get_program_count` verified.
NEXT_PUBLIC_QUID_MILESTONE_ID=CBQPWWJXPA4Y5ONQOCNXTFLGU7NMM34YSA3JKIGUQY2TFHQ453E5Z2SV
# Issue #341: quid-tip-jar. Not yet deployed to testnet (not tracked in
# quid-contract/README.md#deployed-on-testnet as of this PR) -- replace with
# the real contract id once a deployment exists.
NEXT_PUBLIC_QUID_TIP_JAR_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Soroban JSON-RPC endpoint used to submit transactions and read contract state.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Reward tokens founders may pick on testnet. These are Stellar Asset Contract
# (SAC) ids, not CODE:ISSUER pairs. See quid-contract/README.md#reward-tokens-testnet
NEXT_PUBLIC_REWARD_TOKEN_XLM=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_REWARD_TOKEN_USDC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Stellar Network URLs
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org

# Token contract used for bounties and payouts. This is a Soroban contract
# address (C...), not a ticker: find the issuer asset in stellar.toml / explorer.
NEXT_PUBLIC_NATIVE_TOKEN_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Backend API Base URL
# The backend sets a global `/api` prefix, so the suffix is required.
# Local:  http://localhost:3001/api
# Vercel: leave UNSET -- the browser then uses same-origin /api (see next.config.ts)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
